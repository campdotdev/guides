---
import type { Guide } from '../guide/load.ts';
import { pullRequestOf } from '../guide/schema.ts';
import { pullRequestName } from '../repo-files/names.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import AlsoChanged from './AlsoChanged.astro';
import GuideHeader from './GuideHeader.astro';
import Overview from './Overview.astro';
import StepBlock from './StepBlock.astro';
import StepExplanation from './StepExplanation.astro';

interface Props {
	guide: Guide;
}
const { guide } = Astro.props;
---

<BaseLayout title={guide.meta.title}>
	<noscript slot="head">
		<style>
			/* Without the step script, show every step's code and explanation. */
			.step-code[hidden],
			[data-explains][hidden] {
				display: block;
			}
		</style>
	</noscript>
	<GuideHeader meta={guide.meta} />
	<main class="guide" data-pull={pullRequestName(pullRequestOf(guide.meta))}>
		<section class="steps-pane" aria-label="Steps" data-pane="steps">
			{guide.steps.map((step) => <StepBlock step={step} />)}
			<AlsoChanged files={guide.alsoChanged} />
		</section>
		{/* Search indexes the prose in this pane. Pagefind skips pages without data-pagefind-body. */}
		<section class="explanation-pane" aria-label="Explanation" data-pane="explanation" data-pagefind-body>
			<Overview overview={guide.overview} />
			{guide.steps.map((step) => <StepExplanation step={step} />)}
		</section>
	</main>
</BaseLayout>

<script>
	import { initNarrowLayout } from '../client/narrow-layout.ts';

	initNarrowLayout();
</script>

<style>
	.guide {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(320px, 2fr);
		align-items: start;
	}

	.steps-pane {
		min-width: 0;
		padding: 24px 32px;
		border-right: 1px solid var(--border);
	}

	.explanation-pane {
		position: sticky;
		top: 0;
		max-height: 100vh;
		padding: 24px 32px;
		overflow-y: auto;
	}

	/*
	 * Narrow screens stack the panes. src/client/narrow-layout.ts moves the explanation pane above the steps and
	 * each step's explanation into its block, between the header and the code. Its NARROW query matches this one.
	 */
	@media (width < 800px) {
		.guide {
			display: block;
		}

		.steps-pane {
			padding: 16px;
			border-right: 0;
		}

		.explanation-pane {
			position: static;
			max-height: none;
			padding: 16px 16px 0;
			overflow: visible;
		}

		/* With a step selected, the pane holds only the hidden overview. */
		.explanation-pane:not(:has(> :not([hidden]))) {
			display: none;
		}

		.steps-pane :global([data-explains]) {
			padding: 12px 16px;
			border-top: 1px solid var(--border);
		}
	}
</style>
