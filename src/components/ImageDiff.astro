---
import type { StepImage } from '../guide/images.ts';

interface Props {
	image: StepImage;
	/** A page-unique id for the file's header. */
	id: string;
}
const { image, id } = Astro.props;
const sides = [
	{ caption: 'Before', image: image.before },
	{ caption: 'After', image: image.after },
].filter((side) => side.image !== null);
---

<div class="file" data-file={image.path}>
	<header class="file-header">
		<span class="file-path" id={id}>{image.path}</span>
		<span class="file-status">{image.status}</span>
		<label class="file-reviewed">
			<input type="checkbox" data-reviewed data-path={image.path} data-blob-sha={image.blobSha} />
			Reviewed<span class="visually-hidden"> {image.path}</span>
		</label>
	</header>
	<div class="image-pair" role="group" aria-labelledby={id}>
		{
			sides.map((side) => (
				<figure>
					<figcaption>{side.caption}</figcaption>
					<img src={side.image!.src} alt={side.image!.alt} loading="lazy" decoding="async" />
				</figure>
			))
		}
	</div>
</div>

<style>
	.file {
		margin-bottom: 12px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 6px;
	}

	.file:last-child {
		margin-bottom: 0;
	}

	.file-header {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		padding: 6px 12px;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
		font: 0.8125rem var(--mono);
	}

	.file-path {
		margin-right: auto;
		overflow-wrap: anywhere;
	}

	.file-status {
		color: var(--muted);
	}

	.file-reviewed {
		display: inline-flex;
		flex: none;
		gap: 4px;
		align-items: center;
		font-family: var(--sans);
		cursor: pointer;
	}

	.file-reviewed input {
		margin: 0;
		accent-color: var(--accent);
	}

	.image-pair {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 12px;
		padding: 12px;
	}

	figure {
		margin: 0;
	}

	figcaption {
		margin-bottom: 4px;
		color: var(--muted);
		font-size: 0.75rem;
	}

	/* A checkerboard behind the image shows where it is transparent. */
	img {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--border);
		background: repeating-conic-gradient(var(--surface) 0 25%, var(--bg) 0 50%) 0 0 / 16px 16px;
	}
</style>
