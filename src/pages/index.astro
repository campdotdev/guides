---
import { getCollection } from 'astro:content';
import { guidesByRepo, repoUrl } from '../guide/catalog.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const repos = guidesByRepo(await getCollection('guides'));
---

<BaseLayout title="Guides">
	<main class="doc">
		<h1>Guides</h1>
		<p>Step-by-step guides to campdotdev pull requests, written by the agent that wrote each one.</p>
		<h2 id="repositories">Repositories</h2>
		<ul aria-labelledby="repositories">
			{
				repos.map((group) => (
					<li>
						<a href={repoUrl(group.slug)}>{group.repo}</a>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>
